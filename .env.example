# ============================================
# mailorderpharmacy.io — Environment Variables
# Add these in hPanel → Node.js → Environment Variables
# ============================================

# App URL
NEXTAUTH_URL=https://mailorderpharmacy.io
NEXT_PUBLIC_SITE_URL=https://mailorderpharmacy.io

# Stripe (get from dashboard.stripe.com → Developers → API Keys)
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Gemini AI (get from aistudio.google.com → API Keys)
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# Auth Secret (random 32-char string — already generated below)
NEXTAUTH_SECRET=mop_secret_x9k2p7q4r8s1t5u3v6w0y

# Database
DATABASE_URL=file:./prisma/dev.db
